# Normalize all text files to LF on commit
* text=auto eol=lf

*.js        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf

# The hooks have no extension
.githooks/* text eol=lf

# Binary files: never diff or convert
*.png       binary
*.jpg       binary
*.jpeg      binary
*.svg       binary
